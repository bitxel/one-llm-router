{
  "name": "one-llm-router-frontend",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:compat": "playwright test tests/e2e/data-plane-compat.spec.ts",
    "test:e2e:live": "playwright test tests/e2e/live-upstream-smoke.spec.ts",
    "test:e2e:ui": "playwright test --ui",
    "openapi:generate": "bash ../scripts/codegen-frontend.sh"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@radix-ui/react-dialog": "^1.1.7",
    "@radix-ui/react-label": "^2.1.3",
    "@radix-ui/react-select": "^2.1.7",
    "@radix-ui/react-separator": "^1.1.3",
    "@radix-ui/react-slot": "^1.2.0",
    "@radix-ui/react-switch": "^1.1.4",
    "@tanstack/react-query": "^5.71.0",
    "@tanstack/react-router": "^1.121.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.507.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.55.0",
    "react-is": "19.1.0",
    "recharts": "2.15.4",
    "sonner": "^2.0.3",
    "tailwind-merge": "^3.2.0",
    "tailwindcss": "^4.1.4",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0-beta.5",
    "@hey-api/openapi-ts": "0.96.1",
    "@playwright/test": "^1.51.1",
    "@redocly/cli": "1.34.10",
    "@tailwindcss/vite": "^4.1.4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.14.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^26.0.0",
    "msw": "^2.7.3",
    "typescript": "~5.8.2",
    "vite": "^6.2.5",
    "vitest": "^3.1.1"
  }
}
